FROM node:26-slim

ARG CLAUDE_CODE_VERSION=latest
ARG PHP_VERSION=8.4

RUN apt-get update && apt-get install -y --no-install-recommends \
	ca-certificates \
	curl \
	gnupg \
	git \
	git-delta \
	fzf \
	less \
	procps \
	unzip \
	vim \
	jq \
	man-db \
	gosu \
	iptables \
	ipset \
	iproute2 \
	dnsutils \
	aggregate \
	wl-clipboard \
	xclip \
	&& install -d -m 0755 /etc/apt/keyrings \
	&& curl -fsSL https://packages.sury.org/php/apt.gpg -o /etc/apt/keyrings/php-sury.gpg \
	&& echo "deb [signed-by=/etc/apt/keyrings/php-sury.gpg] https://packages.sury.org/php/ $(. /etc/os-release && echo "$VERSION_CODENAME") main" > /etc/apt/sources.list.d/php-sury.list \
	&& apt-get update && apt-get install -y --no-install-recommends \
	php${PHP_VERSION}-cli \
	php${PHP_VERSION}-mbstring \
	php${PHP_VERSION}-xml \
	php${PHP_VERSION}-curl \
	php${PHP_VERSION}-zip \
	php${PHP_VERSION}-sqlite3 \
	php${PHP_VERSION}-bcmath \
	php${PHP_VERSION}-intl \
	&& curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
	&& echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
	&& apt-get update && apt-get install -y --no-install-recommends gh \
	&& rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

ENV CLAUDE_CONFIG_DIR=/home/node/.claude
# The global npm prefix is root-owned and claude runs as the host uid, so the
# built-in auto-updater can't write there. The container is --rm anyway, so an
# in-place update would be lost on the next run. Update via bin/rebuild instead;
# docker/check-update.sh records new releases at startup and a SessionStart
# hook (docker/update-notice-hook.sh) shows the notice inside Claude Code.
ENV DISABLE_AUTOUPDATER=1
# Exposed so check-update.sh can skip the notice for pinned builds.
ENV CLAUDE_CODE_VERSION=${CLAUDE_CODE_VERSION}
# gosu runs as the host uid, which has no passwd entry, so HOME ends up as "/".
# Claude's update check shells out to `npm view`, which dies without a writable cache.
ENV NPM_CONFIG_CACHE=/tmp/npm-cache
# node:26 ships /home/node as 0700, which locks the host uid out of the mounted config dir.
RUN mkdir -p /home/node/.claude \
	&& mkdir -p /workspaces \
	&& chown -R node:node /home/node/.claude /workspaces \
	&& chmod 755 /home/node \
	&& git config --system core.pager delta \
	&& git config --system interactive.diffFilter "delta --color-only" \
	&& git config --system delta.navigate true \
	&& printf '\n[ -f /usr/share/doc/fzf/examples/key-bindings.bash ] && source /usr/share/doc/fzf/examples/key-bindings.bash\n[ -f /usr/share/doc/fzf/examples/completion.bash ] && source /usr/share/doc/fzf/examples/completion.bash\n' >> /etc/bash.bashrc

# Outbound firewall: allowlist covers what Claude Code itself needs.
# Extend at runtime with EXTRA_ALLOWED_DOMAINS if your workflow needs more.
ENV ALLOWED_DOMAINS="registry.npmjs.org api.anthropic.com statsig.com sentry.io github.com api.github.com objects.githubusercontent.com raw.githubusercontent.com"
COPY docker/init-firewall.sh /usr/local/bin/init-firewall.sh
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY docker/check-update.sh /usr/local/bin/check-update.sh
COPY docker/update-notice-hook.sh /usr/local/bin/update-notice-hook.sh
COPY docker/claude-settings.json /etc/claude-container/settings.json
RUN chmod +x /usr/local/bin/init-firewall.sh /usr/local/bin/entrypoint.sh /usr/local/bin/check-update.sh /usr/local/bin/update-notice-hook.sh

WORKDIR /workspaces
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
